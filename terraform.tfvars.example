# example: cp terraform.tfvars.example terraform.tfvars and edit
aws_region       = "eu-west-1"
environment      = "dev"
instance_type    = "t3.micro"
allowed_ssh_cidr = "0.0.0.0/0" # TODO: restrict to YOUR_IP/32
ssh_public_key   = ""          # optional: "ssh-ed25519 AAAA..."
root_volume_size = 30
opencode_port    = 4096
