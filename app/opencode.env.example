# Local/test values only. NEVER put real secrets here.
# Prod opencode.env is written by user_data (password from SSM, provider keys from SSM via provider-map.sh).
OPENCODE_SERVER_PASSWORD=local-dummy-only
# Provider credentials are dummy-only in local tests. Production values are
# fetched from SSM and never committed here.
ANTHROPIC_API_KEY=local-dummy-anthropic-key
OPENAI_API_KEY=local-dummy-openai-key
