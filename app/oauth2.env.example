# Local/test values only. NEVER put real secrets here.
# Prod oauth2.env is written by user_data (non-secret config from stage.env, secrets from SSM).
OAUTH2_PROXY_CLIENT_ID=local-dummy-client-id
OAUTH2_PROXY_CLIENT_SECRET=local-dummy-only
OAUTH2_PROXY_COOKIE_SECRET=local-dummy-only-32-bytes-minimum-x
OAUTH2_PROXY_GITHUB_USERS=local-dummy-user
OAUTH2_PROXY_REDIRECT_URL=https://localhost/oauth2/callback
