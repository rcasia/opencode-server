# Caddy reverse proxy (ADR-0001, ADR-0007, ADR-0014, ADR-0015). {$DOMAIN}
# and {$BASIC_AUTH} come from the container environment (app.env).
# `localhost` gets a local CA cert, public names get automatic Let's
# Encrypt TLS. The human gate is GitHub SSO via oauth2-proxy
# (forward_auth); the opencode backend password is machine-only —
# Caddy injects it as Basic auth after SSO, so the human never types a
# shared password (issue #17).
#
# Zero-downtime shape: Caddy is the stable edge. Both backend colors are
# always listed as upstreams with `lb_policy first` (active/passive =
# primary/secondary failover), so stopping the live color hands traffic to
# the ready one with retries instead of failures. Never recreate Caddy on
# a backend deploy — `caddy reload` (or nothing) is enough.
{$DOMAIN} {
	# Edge hardening (issue #11). Every directive below is Caddy 2.11
	# core, so `caddy adapt`/`validate` pass unchanged both with
	# DOMAIN=localhost (test-boot) and with a public FQDN.
	#
	# NOTE: no `rate_limit` here on purpose. Stock caddy:2.11-alpine
	# has no rate_limit handler (it is an xcaddy-only plugin,
	# mholt/caddy-ratelimit, not compiled into the official image),
	# so a rate_limit block would fail `caddy adapt`. Brute-force
	# detection stays on the monitoring login-probe alarm until the
	# edge image ships a limiter.
	request_body {
		# Cap request bodies edge-wide (default: unbounded). 10MB
		# leaves ample headroom for agent API posts while blunting
		# large-body DoS against the backends; the SSO login and
		# callback posts are a few KB.
		max_size 10MB
	}
	header {
		# No MIME sniffing; no clickjacking (belt and braces: legacy
		# X-Frame-Options plus modern frame-ancestors — the UI and the
		# oauth2-proxy login page are top-level navigations, never
		# iframed); no Referer leakage (the SSO flow carries its
		# return URL in the explicit ?rd= param, never in Referer);
		# drop the Server banner. None of these alter status codes,
		# bodies, or redirect targets, so /ping, /ready, /oauth2/*,
		# and the 302-to-/oauth2/* gate behave exactly as before.
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
	}
	# HSTS only for real domains: never pin localhost (test-boot uses
	# DOMAIN=localhost with a local CA cert; a localhost pin would be
	# wrong). A prod Host is the public FQDN, so it always matches and
	# gets the pin. `preload` is deliberately omitted (needs registry
	# submission and pins aggressively).
	@hsts not host localhost 127.0.0.1
	header @hsts Strict-Transport-Security "max-age=31536000; includeSubDomains"
	# Unauthenticated liveness probe for the edge itself. Answers even
	# when both backends are down — tells edge apart from app.
	handle /ping {
		respond "ok" 200
	}
	# Public readiness gate (ADR-0015). 200 "ready" only when a backend
	# answers 2xx/3xx; 503 otherwise. deploy-app polls this before
	# stopping the live color, and the Route53 probe pages on it.
	# No forward_auth here on purpose: readiness must be checkable
	# without a login. Bodies are masked so the UI never leaks past SSO.
	handle /ready {
		rewrite * /
		reverse_proxy opencode-blue:4096 opencode-green:4096 {
			header_up Authorization "Basic {$BASIC_AUTH}"
			lb_policy first
			lb_try_duration 5s
			lb_retries 2
			# Active health checks (mirrors the main route): without
			# them a stopped color is never marked down and `first`
			# keeps routing to it forever (observed as permanent
			# /ready 502s after a switch, since stopped containers
			# leave Docker DNS).
			health_uri /
			health_interval 5s
			health_timeout 3s
			health_status 2xx
			health_follow_redirects
			health_headers {
				Authorization "Basic {$BASIC_AUTH}"
			}
			@ok status 200 201 204 301 302 303 307 308
			handle_response @ok {
				respond "ready" 200
			}
			handle_response {
				respond "not ready" 503
			}
		}
	}
	# oauth2-proxy's own endpoints (login, callback, sign_in) proxy
	# straight through without an auth check — they ARE the login flow.
	# X-Forwarded-Uri is required for correct redirects behind Caddy.
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Uri {uri}
		}
	}
	handle {
		# forward_auth automatically sets X-Forwarded-{For,Proto,Host,
		# Method,Uri}; 401s (logged-out) redirect to the sign_in page
		# instead of surfacing basic-auth to the browser.
		forward_auth oauth2-proxy:4180 {
			uri /oauth2/auth
			header_up X-Real-IP {remote_host}
			copy_headers X-Auth-Request-User X-Auth-Request-Email
			@error status 401
			handle_response @error {
				redir * /oauth2/sign_in?rd={scheme}://{host}{uri}
			}
		}
		reverse_proxy opencode-blue:4096 opencode-green:4096 {
			header_up Authorization "Basic {$BASIC_AUTH}"
			# Primary/secondary failover across the blue-green pair:
			# serve the first healthy color, retry in-flight requests
			# while the switch happens instead of failing them.
			lb_policy first
			lb_try_duration 10s
			lb_retries 3
			fail_duration 30s
			health_uri /
			health_interval 5s
			health_timeout 3s
			health_status 2xx
			health_follow_redirects
			health_headers {
				Authorization "Basic {$BASIC_AUTH}"
			}
			# Keep agent websocket sessions alive across `caddy reload`
			# (Caddyfile-only deploys): give clients 5 minutes to drain
			# instead of cutting them at the swap.
			stream_close_delay 5m
		}
	}
	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 3
		}
		format json
	}
}
