# terraform (root stack lives in infra/)
.terraform/
infra/modules/*/.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# vars with secrets - never commit (except checked-in env defaults)
*.tfvars
!*.example.tfvars
!infra/environments/*.tfvars
*.tfvars.json

# backend config names the state bucket - local only, like tfvars
backend.hcl

# generated moto AMI id (make local-up writes it)
infra/environments/local.auto.tfvars.json

# cli
.aws/

# app runtime env (dummy locally, SSM-backed password on prod) + caddy logs
app/app.env
app/logs/
# test-boot fetches the pinned nono musl binary here for the container mount
app/.nono-bin/
app/nono-container
# test-boot ARM override (throwaway, trap-removed, never committed)
app/compose.override.yaml
